generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Survey {
  id                String     @id
  title             String
  slug              String     @unique
  description       String?
  demographicFields Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  sections          Section[]
  responses         Response[]
}

model Section {
  id          String     @id
  surveyId    String
  title       String
  description String?
  sortOrder   Int
  survey      Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions   Question[]

  @@index([surveyId])
}

model Question {
  id          String   @id
  sectionId   String
  title       String
  description String?
  type        String
  config      Json
  sortOrder   Int
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@index([sectionId])
}

model Response {
  id                String   @id
  surveyId          String
  submittedAt       DateTime @default(now())
  participantName   String?
  gender            String?
  ageGroup          String?
  demographicValues Json?
  survey            Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers           Answer[]

  @@index([surveyId])
}

model Answer {
  id         String   @id
  responseId String
  questionId String
  value      String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
  @@index([questionId])
}
