# Vercel Blob (production on Vercel — auto-injected when Blob store is linked)
BLOB_READ_WRITE_TOKEN=

# Optional: public | private (unset = try public first, then private)
# Vercel Blob store가 public이면 public, private이면 private 로 설정
BLOB_STORE_ACCESS=public

# Vercel KV / Upstash Redis (recommended — auto-injected when Redis is linked)
# When set, KV is used instead of Blob (avoids Blob Advanced Operations limits)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# One-time browser import at /admin/import (set any secret string)
DATA_IMPORT_KEY=
