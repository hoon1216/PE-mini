# 로컬 개발 (docker compose up -d 후 사용)
DATABASE_URL="postgresql://pepmini:pepmini@localhost:5433/pepmini"
DIRECT_URL="postgresql://pepmini:pepmini@localhost:5433/pepmini"

# 관리자 로그인 (/, /admin, 관리 API 접근 시 필요)
ADMIN_USERNAME="prmadt"
ADMIN_PASSWORD="123456"
# ADMIN_SESSION_SECRET="change-me-in-production"

# Vercel/Neon 배포 시 (Storage → Neon 연결 시 자동 주입)
# DATABASE_URL: pooler 호스트(-pooler 포함) — 일반 쿼리용
# DIRECT_URL: direct 호스트(-pooler 없음) — 트랜잭션용
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Neon 무료 플랜은 유휴 시 DB가 suspend 됩니다. 첫 요청이 느리거나 실패할 수 있으니 잠시 후 새로고침하세요.
